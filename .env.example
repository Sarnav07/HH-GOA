# Required for Share to X via link (the OG-preview path).
# Create a Blob store in the Vercel dashboard: Storage > Blob, then copy the
# token here. `vercel env pull` writes it for you on a linked project.
# Without it the app still works: download and the mobile native share sheet
# are unaffected, and the desktop share button reports that link sharing is off.
BLOB_READ_WRITE_TOKEN=

# Only needed if the deployment URL is not the Vercel production domain,
# for example a custom domain. Used to build absolute OG image URLs.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
